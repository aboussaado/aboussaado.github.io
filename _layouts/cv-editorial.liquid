---
layout: default
---

{% assign cv = site.data.cv.cv %}

<section class="cv-page">

  <!-- CV SECTION RAIL -->
  <nav class="cv-page__rail" aria-label="CV sections">

    <a href="#experience" data-cv-section="experience">
      <span class="cv-page__rail-number">01</span>
      <span class="cv-page__rail-label">Experience</span>
      <span class="cv-page__rail-line"></span>
    </a>

    <a href="#education" data-cv-section="education">
      <span class="cv-page__rail-number">02</span>
      <span class="cv-page__rail-label">Education</span>
      <span class="cv-page__rail-line"></span>
    </a>

    <a href="#publications" data-cv-section="publications">
      <span class="cv-page__rail-number">03</span>
      <span class="cv-page__rail-label">Publications</span>
      <span class="cv-page__rail-line"></span>
    </a>

    <a href="#awards" data-cv-section="awards">
      <span class="cv-page__rail-number">04</span>
      <span class="cv-page__rail-label">Awards</span>
      <span class="cv-page__rail-line"></span>
    </a>

    <a href="#skills" data-cv-section="skills">
      <span class="cv-page__rail-number">05</span>
      <span class="cv-page__rail-label">Skills</span>
      <span class="cv-page__rail-line"></span>
    </a>

    <a href="#certificates" data-cv-section="certificates">
      <span class="cv-page__rail-number">06</span>
      <span class="cv-page__rail-label">Certificates</span>
      <span class="cv-page__rail-line"></span>
    </a>

  </nav>
  <!-- /CV SECTION RAIL -->



  <div class="cv-page__inner">

    <!-- ==================================================
         HERO
         ================================================== -->

    <header class="cv-page__hero">

      <div class="cv-page__hero-copy">

        <span class="cv-page__eyebrow">
          Curriculum Vitae
        </span>

        <h1>CV</h1>

        <p class="cv-page__intro">
          Applied mathematics, machine learning
          &amp; dynamical systems.
        </p>

      </div>
      <div class="cv-page__rossler" aria-hidden="true">
        <svg
          class="rossler-attractor"
          viewBox="0 0 620 420"
          preserveAspectRatio="xMidYMid meet"
        >
          <path class="rossler-attractor__glow"></path>
          <path class="rossler-attractor__curve"></path>
        </svg>
      </div>


      <div class="cv-page__meta">

        {% if page.cv_pdf %}
          <a
            class="cv-page__download"
            href="{{ page.cv_pdf | relative_url }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            Download PDF ↗
          </a>
        {% endif %}

        {% if cv.location %}
          <span>{{ cv.location }}</span>
        {% endif %}

        {% if cv.email %}
          <a href="mailto:{{ cv.email }}">
            {{ cv.email }}
          </a>
        {% endif %}

        {% if cv.social_networks %}
          <div class="cv-page__socials">

            {% for social in cv.social_networks %}

              {% if social.network == "GitHub" %}
                <a
                  href="https://github.com/{{ social.username }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  GitHub ↗
                </a>

              {% elsif social.network == "LinkedIn" %}
                <a
                  href="https://www.linkedin.com/in/{{ social.username }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  LinkedIn ↗
                </a>

              {% elsif social.network == "Google Scholar" %}
                <a
                  href="https://scholar.google.com/citations?user={{ social.username }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Scholar ↗
                </a>
              {% endif %}

            {% endfor %}

          </div>
        {% endif %}

      </div>

    </header>


    <!-- ==================================================
         01 EXPERIENCE
         ================================================== -->

    {% if cv.sections.Experience %}

      <section class="cv-section" id="experience">

        <header class="cv-section__heading">
          <span class="cv-section__number">01</span>
          <h2>Experience</h2>
        </header>

        <div class="cv-section__content">

          {% for entry in cv.sections.Experience %}

            {% assign start_year = entry.start_date | slice: 0, 4 %}
            {% assign end_year = entry.end_date | slice: 0, 4 %}

            <article class="cv-entry cv-track-item">

              <div class="cv-entry__date">
                {% if start_year == end_year %}
                  {{ start_year }}
                {% else %}
                  {{ start_year }}–{{ end_year | slice: 2, 2 }}
                {% endif %}
              </div>

              <div class="cv-entry__main">

                <h3>{{ entry.company }}</h3>

                <p class="cv-entry__role">
                  {{ entry.position }}
                </p>

                {% if entry.location %}
                  <p class="cv-entry__location">
                    {{ entry.location }}
                  </p>
                {% endif %}

                {% if entry.summary %}
                  <div class="cv-entry__summary">
                    {{ entry.summary | markdownify }}
                  </div>
                {% endif %}

                {% if entry.highlights %}
                  <ul class="cv-entry__highlights">
                    {% for item in entry.highlights %}
                      <li>{{ item }}</li>
                    {% endfor %}
                  </ul>
                {% endif %}

              </div>

            </article>

          {% endfor %}

        </div>

      </section>

    {% endif %}


    <!-- ==================================================
         02 EDUCATION
         ================================================== -->

    {% if cv.sections.Education %}

      <section class="cv-section" id="education">

        <header class="cv-section__heading">
          <span class="cv-section__number">02</span>
          <h2>Education</h2>
        </header>

        <div class="cv-section__content">

          {% for entry in cv.sections.Education %}

            {% assign start_year = entry.start_date | slice: 0, 4 %}
            {% assign end_year = entry.end_date | slice: 0, 4 %}

            <article class="cv-entry cv-track-item">

              <div class="cv-entry__date">

                {% if start_year == end_year %}
                  {{ start_year }}
                {% else %}
                  {{ start_year }}–{{ end_year | slice: 2, 2 }}
                {% endif %}

              </div>

              <div class="cv-entry__main">

                <h3>{{ entry.institution }}</h3>

                <p class="cv-entry__role">
                  {{ entry.studyType }}
                  {% if entry.area %}
                    · {{ entry.area }}
                  {% endif %}
                </p>

                {% if entry.location %}
                  <p class="cv-entry__location">
                    {{ entry.location }}
                  </p>
                {% endif %}

                {% if entry.summary %}
                  <div class="cv-entry__summary">
                    {{ entry.summary | markdownify }}
                  </div>
                {% endif %}

                {% if entry.highlights %}
                  <ul class="cv-entry__highlights">
                    {% for item in entry.highlights %}
                      <li>{{ item }}</li>
                    {% endfor %}
                  </ul>
                {% endif %}

              </div>

            </article>

          {% endfor %}

        </div>

      </section>

    {% endif %}


    <!-- ==================================================
         03 PUBLICATIONS
         ================================================== -->

    {% if cv.sections.Publications %}

      <section class="cv-section" id="publications">

        <header class="cv-section__heading">
          <span class="cv-section__number">03</span>
          <h2>Publications</h2>
        </header>

        <div class="cv-section__content">

          {% for entry in cv.sections.Publications %}

            <article class="cv-publication cv-track-item">

              <div class="cv-entry__date">
                {{ entry.releaseDate }}
              </div>

              <div class="cv-entry__main">

                <h3>{{ entry.title }}</h3>

                {% if entry.authors %}
                  <p class="cv-publication__authors">
                    {% for author in entry.authors %}
                      <span
                        {% if author == cv.name %}
                          class="cv-publication__self"
                        {% endif %}
                      >
                        {{ author }}
                      </span>{% unless forloop.last %}, {% endunless %}
                    {% endfor %}
                  </p>
                {% endif %}

                {% if entry.publisher %}
                  <p class="cv-publication__venue">
                    {{ entry.publisher }}
                  </p>
                {% endif %}

                {% if entry.url %}
                  <a
                    class="cv-publication__link"
                    href="{{ entry.url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    View publication ↗
                  </a>
                {% endif %}

              </div>

            </article>

          {% endfor %}

        </div>

      </section>

    {% endif %}


    <!-- ==================================================
         04 AWARDS
         ================================================== -->

    {% if cv.sections.Awards %}

      <section class="cv-section" id="awards">

        <header class="cv-section__heading">
          <span class="cv-section__number">04</span>
          <h2>Awards</h2>
        </header>

        <div class="cv-section__content">

          {% for entry in cv.sections.Awards %}

            <article class="cv-award cv-track-item">

              <div class="cv-entry__date">
                {{ entry.date | slice: 0, 4 }}
              </div>

              <div class="cv-entry__main">

                <h3>{{ entry.title }}</h3>

                {% if entry.awarder %}
                  <p class="cv-entry__role">
                    {{ entry.awarder }}
                  </p>
                {% endif %}

                {% if entry.summary %}
                  <div class="cv-entry__summary">
                    {{ entry.summary | markdownify }}
                  </div>
                {% endif %}

              </div>

            </article>

          {% endfor %}

        </div>

      </section>

    {% endif %}


    <!-- ==================================================
         05 SKILLS & LANGUAGES
         ================================================== -->

    {% if cv.sections.Skills or cv.sections.Languages %}

      <section class="cv-section cv-section--compact" id="skills">

        <header class="cv-section__heading">
          <span class="cv-section__number">05</span>
          <h2>Skills &amp;<br>Languages</h2>
        </header>

        <div class="cv-section__content">

          {% if cv.sections.Skills %}

            <div class="cv-skills">

              {% for entry in cv.sections.Skills %}

                <div class="cv-skill-group">

                  <h3>{{ entry.name }}</h3>

                  <p>
                    {{ entry.keywords }}
                  </p>

                </div>

              {% endfor %}

            </div>

          {% endif %}


          {% if cv.sections.Languages %}

            <div class="cv-languages">

              {% for language in cv.sections.Languages %}

                <div class="cv-language">

                  <span>{{ language.name }}</span>

                  <span>
                    {{ language.summary }}
                  </span>

                </div>

              {% endfor %}

            </div>

          {% endif %}

        </div>

      </section>

    {% endif %}


    <!-- ==================================================
         06 SELECTED CERTIFICATES
         ================================================== -->

    {% if cv.sections.Certificates %}

      <section class="cv-section" id="certificates">

        <header class="cv-section__heading">
          <span class="cv-section__number">06</span>
          <h2>Selected<br>Certificates</h2>
        </header>

        <div class="cv-section__content">

          {% for entry in cv.sections.Certificates %}

            <article class="cv-certificate cv-track-item">

              <div class="cv-entry__date">
                {{ entry.date | slice: 0, 4 }}
              </div>

              <div class="cv-entry__main">

                <h3>{{ entry.name }}</h3>

                {% if entry.issuer %}
                  <p class="cv-entry__role">
                    {{ entry.issuer }}
                  </p>
                {% endif %}

                {% if entry.summary %}
                  <div class="cv-entry__summary">
                    {{ entry.summary | markdownify }}
                  </div>
                {% endif %}

              </div>

            </article>

          {% endfor %}

        </div>

      </section>

    {% endif %}

  </div>

</section>

<script src="{{ '/assets/js/cv-editorial.js' | relative_url }}"></script>
<script src="{{ '/assets/js/cv-rossler.js' | relative_url }}"></script>
